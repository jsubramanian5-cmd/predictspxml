<Window x:Class="ForecastViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPX Forecast Viewer" Height="600" Width="980"
        Icon="{StaticResource LogoImage}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,3"
                    Margin="6,0,0,0" Click="Browse_Click" />
            <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,3"
                    Click="Refresh_Click" />
            <Image Source="{StaticResource LogoImage}" Width="28" Height="28" Margin="0,0,8,0" />
            <TextBlock Text="SPX Forecast Viewer" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock x:Name="SourceText" VerticalAlignment="Center" Foreground="#666"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#666" />
        <TabControl>
            <TabItem Header="Weekly">
                <DockPanel x:Name="WeeklyPanel" Margin="8" />
            </TabItem>
            <TabItem Header="Monthly">
                <DockPanel x:Name="MonthlyPanel" Margin="8" />
            </TabItem>
            <TabItem Header="Live scorecard">
                <DockPanel x:Name="ScorecardPanel" Margin="8" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
