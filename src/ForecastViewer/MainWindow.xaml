<Window x:Class="ForecastViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPX Forecast Viewer" Height="600" Width="980"
        Icon="{StaticResource LogoImage}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,3"
                    Margin="6,0,0,0" Click="Browse_Click" />
            <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,3"
                    Click="Refresh_Click" />
            <Image Source="{StaticResource LogoImage}" Width="28" Height="28" Margin="0,0,8,0" />
            <TextBlock Text="SPX Forecast Viewer" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock x:Name="SourceText" VerticalAlignment="Center" Foreground="#666"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#666" />
        <TabControl>
            <TabItem Header="Weekly">
                <DockPanel x:Name="WeeklyPanel" Margin="8" />
            </TabItem>
            <TabItem Header="Monthly">
                <DockPanel x:Name="MonthlyPanel" Margin="8" />
            </TabItem>
            <TabItem Header="Live scorecard">
                <DockPanel x:Name="ScorecardPanel" Margin="8" />
            </TabItem>
            <TabItem Header="Iron condor">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Wing width (pts)" VerticalAlignment="Center" />
                        <TextBox x:Name="WingBox" Text="25" Width="50" Margin="6,0,16,0" />
                        <TextBlock Text="Rate %" VerticalAlignment="Center" />
                        <TextBox x:Name="RateBox" Text="4.0" Width="50" Margin="6,0,16,0" />
                        <TextBlock Text="Div yield %" VerticalAlignment="Center" />
                        <TextBox x:Name="DivBox" Text="1.3" Width="50" Margin="6,0,16,0" />
                        <Button Content="Recalculate" Padding="10,3" Click="Recalculate_Click" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Theoretical Black-Scholes estimate: one flat volatility (VIX9D for weekly, VIX for monthly), no skew, no live quotes. Credit and delta are per 1-lot (x100). Use real chain quotes before trading." />
                    <DockPanel x:Name="CondorPanel" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
